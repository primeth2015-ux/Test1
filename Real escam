RunService.Heartbeat:Connect(function()
    local char = LP.Character
    if not char then
        _G._AmbitiousAntiBatDesiredXZ = nil
        return
    end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root or not root.Parent then
        _G._AmbitiousAntiBatDesiredXZ = nil
        return
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then
        _G._AmbitiousAntiBatDesiredXZ = nil
        return
    end

    if speedEngineBlocked() then
        speedEnabled = false
        _G._AmbitiousAntiBatDesiredXZ = nil
        if speedLabel then speedLabel.Text = string.format("%.1f", getActiveMoveSpeed()) end
        return
    end

    if isRagdollState(hum) then
        lastMoveDir = Vector3.new(0, 0, 0)
        speedEnabled = false
        _G._AmbitiousAntiBatDesiredXZ = nil
        if speedLabel then speedLabel.Text = string.format("%.1f", getActiveMoveSpeed()) end
        return
    end

    if aimbotMovementActive() then
        speedEnabled = false
        _G._AmbitiousAntiBatDesiredXZ = nil
        if speedLabel then speedLabel.Text = string.format("%.1f", getActiveMoveSpeed()) end
        return
    end

    local md = hum.MoveDirection
    local spd = getActiveMoveSpeed()
    if not spd or spd <= 0 then
        _G._AmbitiousAntiBatDesiredXZ = nil
        if speedLabel then speedLabel.Text = string.format("%.1f", getActiveMoveSpeed()) end
        return
    end

    if not speedEnabled then
        speedEnabled = true
        claimSpeedOwnership(root)
    end

