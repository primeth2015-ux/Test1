-- ============================================================
-- SPEED ENGINE (motor do MysteryDuels) - ROOT VELOCITY
-- Speed Normal / Carry Mode / Lagger / Lagger Carry usam todos o
-- MESMO motor: escreve X/Z direto na root.Velocity e deixa o Y com o
-- jogo, entao pulo e queda continuam normais. So muda o valor
-- devolvido por getActiveMoveSpeed().
--
-- ANTI BAT: publica a X/Z desejada em _G._AmbitiousAntiBatDesiredXZ,
-- que o Anti Bat reaplica depois de cada spike. Enquanto o spike roda
-- (_G._AmbitiousAntiBatSpiking) o motor NAO escreve.
-- ============================================================
do -- escopo proprio do motor (mantem os registros do chunk livres)
local speedEnabled = false

local function speedEngineBlocked()
    -- Drop tem motor proprio de movimento.
    return dropActive == true
end

local function aimbotMovementActive()
    -- Auto Bat / aimbots tem o proprio mover.
    return autoBatEnabled == true
end

local function claimSpeedOwnership(root)
    pcall(function() root:SetNetworkOwner(LP) end)
end

